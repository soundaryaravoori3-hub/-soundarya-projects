---
import { projects } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---
<section id="projects" class="section">
  <div class="container">
    <SectionHeader
      index="04"
      eyebrow="Projects"
      title="Selected work."
      lead="Two areas of work from my product and operations experience."
    />
    <div class="project-grid">
      {projects.map((p) => (
        <article class="project-card reveal">
          <p class="project-category">{p.category}</p>
          <h3>{p.title}</h3>
          <dl class="project-body">
            {p.context && <div><dt>Context</dt><dd>{p.context}</dd></div>}
            {p.role && <div><dt>My role</dt><dd>{p.role}</dd></div>}
            {p.approach && p.approach.length > 0 && (
              <div>
                <dt>Approach</dt>
                <dd><ul>{p.approach.map((a) => <li>{a}</li>)}</ul></dd>
              </div>
            )}
            {p.outcome && <div class="project-outcome"><dt>Outcome</dt><dd>{p.outcome}</dd></div>}
          </dl>
          {p.tools && p.tools.length > 0 && (
            <ul class="tags" aria-label="Tools used">
              {p.tools.map((t) => <li>{t}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
