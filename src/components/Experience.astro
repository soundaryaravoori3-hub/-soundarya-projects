---
import { experience } from '../data/content';
import SectionHeader from './SectionHeader.astro';
import Metrics from './Metrics.astro';
---
<section id="experience" class="section section-tint">
  <div class="container">
    <SectionHeader index="02" eyebrow="Experience" title="Where I have worked." />
    <ol class="timeline">
      {experience.map((role) => (
        <li class="timeline-item reveal">
          <div class="timeline-meta">
            <p class="timeline-period">{role.period}</p>
            {role.status && <p class="status-pill">{role.status}</p>}
          </div>
          <article class="role-card">
            <h3>{role.title}</h3>
            <p class="role-org">{role.organisation}</p>
            {role.metrics && role.metrics.length > 0 && <Metrics items={role.metrics} label="Key results" />}
            {role.points && role.points.length > 0 && (
              <ul class="role-points">
                {role.points.map((pt) => <li>{pt}</li>)}
              </ul>
            )}
            {role.tags && role.tags.length > 0 && (
              <ul class="tags" aria-label="Keywords">
                {role.tags.map((t) => <li>{t}</li>)}
              </ul>
            )}
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>
