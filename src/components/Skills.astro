---
import { skills } from '../data/content';
import SectionHeader from './SectionHeader.astro';
import Rich from './Rich.astro';
---
<section id="skills" class="section section-tint">
  <div class="container">
    <SectionHeader index="05" eyebrow="Skills" title="What I bring to a team." lead="Skills from my experience and MBA. I only list what I have used in practice." />
    <div class="skill-grid">
      {skills.map((s) => (
        <article class="skill-card reveal">
          <h3>{s.group}</h3>
          <ul>
            {s.items.map((i) => <li><Rich text={i} /></li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
