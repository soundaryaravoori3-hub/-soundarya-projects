---
import { skills, tools } from '../data/content';
import SectionHeader from './SectionHeader.astro';
---
<section id="skills" class="section section-tint">
  <div class="container">
    <SectionHeader index="05" eyebrow="Skills & tools" title="What I bring to a team." />
    <div class="skill-grid">
      {skills.map((s) => (
        <article class="skill-card reveal">
          <h3>{s.group}</h3>
          <p class="skill-source">{s.source}</p>
          <ul>
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <h3 class="sub-heading tools-heading reveal">Tools</h3>
    <ul class="tool-grid">
      {tools.map((t) => (
        <li class="tool-card reveal">
          <span class="tool-mark" aria-hidden="true">{t.name.charAt(0)}</span>
          <div>
            <p class="tool-name">{t.name}</p>
            <p class="tool-use">{t.use}</p>
            <p class="tool-source">{t.source}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
