---
import { currentRole, hero, site } from '../data/content';
const photo = hero.photo ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${hero.photo}` : '';
---
<section id="home" class="hero">
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <ul class="positioning reveal" aria-label="Focus areas">
        {hero.positioning.map((p) => <li>{p}</li>)}
      </ul>
      <h1 class="reveal">
        <span class="hero-name">{site.name}</span>
        <span class="hero-headline">{hero.headline}</span>
      </h1>
      <p class="hero-intro reveal">{hero.intro}</p>
      <div class="hero-actions reveal">
        <a class="btn btn-primary" href="#experience">View experience</a>
        <a class="btn btn-ghost" href="#projects">Selected work</a>
      </div>
      <div class="role-block reveal">
        <p class="role-list-label">Open to</p>
        <ul class="role-list" aria-label="Roles I am open to">
          {hero.targetRoles.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>

    <aside class="hero-card reveal" aria-label="At a glance">
      <div class="hero-card-top">
        {photo ? (
          <img class="avatar" src={photo} alt={`Portrait of ${site.name}`} width="72" height="72" />
        ) : (
          <div class="avatar avatar-initials" aria-hidden="true">{site.initials}</div>
        )}
        <div>
          <p class="hero-card-name">{site.name}</p>
          <p class="hero-card-role">{hero.qualifications}</p>
          <p class="hero-card-next"><span class="dot"></span><span><span class="hero-card-now">Current role</span>{currentRole.title}, {currentRole.organisation}</span></p>
        </div>
      </div>
      <p class="stats-label">Career highlights · previous roles</p>
      <dl class="stats">
        {hero.highlights.map((h) => (
          <div class="stat">
            <dt>{h.label}{h.source && <span class="stat-source">{h.source}</span>}</dt>
            <dd>{h.value}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>
