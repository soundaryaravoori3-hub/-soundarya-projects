---
import { projects } from '../data/content';
import SectionHeader from './SectionHeader.astro';
import Metrics from './Metrics.astro';
---
<section id="projects" class="section">
  <div class="container">
    <SectionHeader index="03" eyebrow="Selected work" title="Case study." />
    <div class:list={['project-grid', { single: projects.length === 1 }]}>
      {projects.map((p) => (
        <article class="project-card reveal">
          <header class="project-head">
            <p class="project-category">{p.category}</p>
            <h3>{p.title}</h3>
          </header>
          <dl class="project-body">
            {p.challenge && <div><dt>Challenge</dt><dd>{p.challenge}</dd></div>}
            {p.actions && p.actions.length > 0 && (
              <div>
                <dt>Actions</dt>
                <dd><ul>{p.actions.map((a) => <li>{a}</li>)}</ul></dd>
              </div>
            )}
          </dl>
          <div class="project-side">
            {p.results && p.results.length > 0 && (
              <div class="project-outcome">
                <p class="project-results-label">Results</p>
                <Metrics items={p.results} label="Results" />
              </div>
            )}
            {p.tools && p.tools.length > 0 && (
              <div class="project-tools">
                <p class="project-results-label">Tools</p>
                <ul class="tags" aria-label="Tools">
                  {p.tools.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
